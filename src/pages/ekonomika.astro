const articles = [
  {
    "title": "Photon Energy ji prodala během insolvenčního řízení. Teď padla a v majetku jí zůstala Tesla a miliony v mlze",
    "link": "https://www.e15.cz/byznys/prumysl-a-energetika/photon-energy-ji-prodala-behem-insolvencniho-rizeni-ted-padla-a-v-majetku-ji-zustala-tesla-a-miliony-v-mlze-1436909",
    "pubDate": "Wed, 28 Oct 2026 11:00:00 +0100",
    "contentSnippet": "Rychlý prodej do Švýcarska nepomohl. \nZadlužená servisní firma Photon Energy skončila v úpadku.\nNový majitel navíc nedokázal řádně předložit evidenci majetku.",
    "source": "E15.cz",
    "category": "ekonomika"
  },
  {
    "title": "Ve Španělsku se srazily vysokorychlostní vlaky. Zemřelo nejméně deset lidí",
